{
  "name": "pairus/product-data",
  "version": "1.6.0",
  "description": "SDK oficial da PAIRUS para integração com catálogo GTIN/EAN, predição fiscal (IBS/CBS/IS), saneamento em lote e emissão de NF-e/NFC-e e NFS-e Nacional.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "PAIRUS Soluções Tecnológicas",
      "email": "suporte@pairus.com.br",
      "homepage": "https://pairus.com.br"
    }
  ],
  "homepage": "https://pairus.com.br",
  "support": {
    "email": "suporte@pairus.com.br",
    "docs": "https://api.pairus.com.br/docs",
    "source": "https://github.com/marcos2r/api-consulta-gtin"
  },
  "keywords": [
    "pairus",
    "gtin",
    "ean",
    "fiscal",
    "reforma-tributaria",
    "ibs",
    "cbs",
    "imposto-seletivo",
    "nfe",
    "nfse",
    "nfs-e",
    "sefaz",
    "ocr",
    "woocommerce",
    "laravel"
  ],
  "require": {
    "php": ">=8.1.0",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Pairus\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pairus\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
